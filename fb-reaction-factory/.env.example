# Facebook Page publishing
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v26.0

# Instagram account + sales DM webhook
# Use the Instagram professional account ID already linked to the Meta app.
META_IG_USER_ID=
# Optional dedicated Instagram Login token. If blank, the app falls back to
# META_PAGE_ACCESS_TOKEN / META_SYSTEM_USER_ACCESS_TOKEN / META_USER_ACCESS_TOKEN.
INSTAGRAM_ACCESS_TOKEN=
# Random secret string you choose in Meta webhook configuration.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
# Meta App Secret used to validate X-Hub-Signature-256 on incoming webhooks.
META_APP_SECRET=
# Comma-separated words that trigger a private reply from Reel comments.
INSTAGRAM_DM_KEYWORDS=reels,grow,content,video
# Optional; automatically chosen if blank.
INSTAGRAM_GRAPH_HOST=
INSTAGRAM_GRAPH_VERSION=v26.0
# Keep disabled in production. Only useful for local webhook testing.
INSTAGRAM_WEBHOOK_ALLOW_UNSIGNED=0

# AI metadata + Instagram sales replies
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_DM_MODEL=gpt-5
REACTION_FACTORY_OFFER_PRICE=$299/month

# Posting defaults
POSTS_PER_DAY=4
POST_TIMES=11:00,14:00,17:00,20:00
TIMEZONE=America/Chicago
